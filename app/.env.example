# Copy to .env for local development.
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SCOPES / SHOPIFY_APP_URL are injected
# by `shopify app dev` — only the service URLs below need to be set manually.
DATABASE_URL="postgresql://shopify:shopify@localhost:5432/shopify_ai_search"
OPENSEARCH_URL="http://localhost:9200"
