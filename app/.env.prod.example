# Copy to .env.prod on the SERVER only. Never commit .env.prod.
# DATABASE_URL and OPENSEARCH_URL are set by docker-compose.prod.yml.
# You only set the values below.

# Strong password for the Postgres container. Compose reads it for both
# the postgres service and the app DATABASE_URL.
POSTGRES_PASSWORD=

# Shopify app credentials (Partners dashboard -> your app -> API credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products

# Your public HTTPS URL (the DuckDNS host).
SHOPIFY_APP_URL=https://hebrew-ai-search.duckdns.org
