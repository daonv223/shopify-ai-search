{%- comment -%}
  AI Search results — app block for the search template (Phase 4 spec
  §3.3). Add it through the theme editor: Search template → Add section →
  "Apps" → "AI Search results". Renders the results grid for the current
  `q` from /apps/search/results (RTL, Shadow DOM, "load more"); the app
  embed hides the theme's native results section while this block is on
  the page, and un-hides it if the endpoint fails (never a blank page).
{%- endcomment -%}
{%- assign hide = block.settings.hide_native_selector | strip -%}
{%- if hide == blank -%}
  {%- assign hide = '.shopify-section:has(> .template-search), .shopify-section:has(.template-search__results), .shopify-section:has(#main-search), .shopify-section:has(.search-results), .shopify-section:has(#MainContent .search)' -%}
{%- endif -%}
<style id="ai-search-hide-native">{{ hide }} { display: none !important; }</style>
<div
  data-ai-search-results
  data-endpoint="/apps/search/results"
  data-limit="{{ block.settings.page_size | default: 24 }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-show-form="{{ block.settings.show_search_form }}"
  data-show-count="{{ block.settings.show_count }}"
  data-native-style="ai-search-hide-native"
  dir="rtl"
  {{ block.shopify_attributes }}
></div>
{%- unless request.design_mode -%}
  <noscript>
    <p><a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&ai=0">{{ 'ai_search.native_link' | t }}</a></p>
  </noscript>
{%- endunless -%}

{% schema %}
{
  "name": "t:results.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:results.heading.label", "default": "תוצאות חיפוש" },
    { "type": "range", "id": "page_size", "label": "t:results.page_size.label", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_search_form", "label": "t:results.show_search_form.label", "default": true },
    { "type": "checkbox", "id": "show_count", "label": "t:results.show_count.label", "default": true },
    { "type": "text", "id": "hide_native_selector", "label": "t:results.hide_native_selector.label", "info": "t:results.hide_native_selector.info" }
  ]
}
{% endschema %}
