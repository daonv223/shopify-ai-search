generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// specs/app-foundation/spec.md §3.5 — sync-state data model

model Shop {
  id                 String    @id // shop domain, e.g. my-store.myshopify.com
  installedAt        DateTime  @default(now())
  uninstalledAt      DateTime?
  metafieldAllowlist Json?
  indexAlias         String
}

model ProductSyncState {
  shop           String
  productId      String
  contentHash    String
  embeddingStale Boolean  @default(true)
  lastSyncedAt   DateTime @default(now())

  @@id([shop, productId])
  @@index([shop, embeddingStale])
}

model SyncRun {
  id              String    @id @default(cuid())
  shop            String
  status          String // running | success | failed
  bulkOperationId String? // admin_graphql_api_id of the Shopify bulk operation
  productCount    Int?
  error           Json?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([shop, startedAt])
  @@index([bulkOperationId])
}

// Per-shop search + provider config (task 5.1). One row per shop.
// Synonyms and boosts apply at QUERY time (search.server.ts) so a merchant
// edit changes results with no reindex/redeploy. The embedding key/model drive
// the ingest sweep; the key is never returned to the browser.
model SearchConfig {
  shop              String   @id // shop domain, e.g. my-store.myshopify.com
  embeddingProvider String   @default("gemini") // gemini (openai deferred to a later phase)
  embeddingModel    String   @default("gemini-embedding-001")
  embeddingApiKey   String? // per-shop key; null → fall back to GEMINI_API_KEY env
  synonyms          Json? // SynonymGroup[]: [{ terms: string[], oneWay: boolean }]
  boosts            Json? // BoostConfig: per-field weight overrides over the Phase 3 defaults
  updatedAt         DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  shop        String
  topic       String
  payload     Json
  status      String    @default("pending") // pending | processed | failed
  error       Json? // failure detail when status=failed (task 5.3) — { message, ... }
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
}
